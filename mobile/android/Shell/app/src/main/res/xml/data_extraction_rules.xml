<?xml version="1.0" encoding="utf-8"?>
<!-- Bundle + state must NOT leave the device via Auto Backup
     (the bundle is bound to the device; transferring it would
     break the wg-cp0 single-peer-per-bundle invariant). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
